<view class="container training-page">
  <view class="card top-card">
    <view class="top-row">
      <view class="mode-title">{{modeText}}</view>
      <view class="stats-line">已答 {{total}} · 对 {{correct}} · {{rate}}%</view>
    </view>
  </view>

  <view wx:if="{{mode !== 'opening'}}" class="card filter-card">
    <view class="filter-grid">
      <view class="filter-row">
        <view class="field-label">开叫类别</view>
        <picker mode="selector" range="{{openerCategoryOptions}}" value="{{openerCategoryIndex}}" bindchange="onOpenerCategoryChange" class="filter-picker">
          <view class="picker-box">{{openerCategoryOptions[openerCategoryIndex]}}</view>
        </picker>
      </view>
      <view class="filter-row">
        <view class="field-label">开叫叫品</view>
        <picker mode="selector" range="{{openerOptions}}" value="{{openerIndex}}" bindchange="onOpenerChange" class="filter-picker">
          <view class="picker-box">{{openerOptions[openerIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{mode === 'opener_rebid' || mode === 'responder_rebid'}}" class="filter-row">
        <view class="field-label">应叫叫品</view>
        <picker mode="selector" range="{{responseBidOptions}}" value="{{responseBidIndex}}" bindchange="onResponseBidChange" class="filter-picker">
          <view class="picker-box">{{responseBidOptions[responseBidIndex]}}</view>
        </picker>
      </view>
      <view wx:if="{{mode === 'responder_rebid'}}" class="filter-row">
        <view class="field-label">开叫者再叫</view>
        <picker mode="selector" range="{{openerRebidBidOptions}}" value="{{openerRebidBidIndex}}" bindchange="onOpenerRebidBidChange" class="filter-picker">
          <view class="picker-box">{{openerRebidBidOptions[openerRebidBidIndex]}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card">
    <view class="subtitle">正在生成题目...</view>
  </view>

  <view wx:elif="{{question}}">
    <view class="card context-card">
      <view class="context-meta">
        <view class="meta-chip"><text class="info-label">局况</text><text>{{question.vulnerability}}</text></view>
        <view class="meta-chip"><text class="info-label">位置</text><text>{{question.position}}</text></view>
      </view>
      <view class="auction">
        <block wx:for="{{auctionBids}}" wx:key="position">
          <view class="auction-bid {{item.strainClass}}" data-bid="{{item.bid}}" data-index="{{index}}" bindtap="showBidMeaning">{{item.bid}}</view>
          <view class="auction-separator">-</view>
        </block>
        <view class="auction-text auction-prompt">?</view>
      </view>
    </view>

    <view class="card hand-card">
      <view class="hand-panel">
        <view class="hand-lines">
          <view wx:for="{{question.hand_lines}}" wx:key="*this" class="hand-line">{{item}}</view>
        </view>
        <view class="metrics">
          <view class="metric">
            <view class="metric-value">{{question.evaluation.hcp}}</view>
            <view class="metric-label">HCP</view>
          </view>
          <view class="metric">
            <view class="metric-value">{{question.evaluation.shape}}</view>
            <view class="metric-label">牌型</view>
          </view>
          <view class="metric">
            <view class="metric-value">{{question.evaluation.balanced ? '是' : '否'}}</view>
            <view class="metric-label">均型</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card bid-card">
      <view class="bid-grid {{bidGridClass}}">
        <block wx:for="{{bidItems}}" wx:key="bid">
          <view class="bid-cell">
            <view wx:if="{{item.legal}}" class="bid-btn {{item.strainClass}} {{selectedBid === item.bid ? 'selected' : ''}} {{submitted ? 'locked' : ''}} {{hoverKey === item.bid ? 'is-hover' : ''}}" hover-class="bid-btn-hover" hover-start-time="0" hover-stay-time="100" data-bid="{{item.bid}}" data-hover="{{item.bid}}" bindmouseenter="onHoverEnter" bindmouseleave="onHoverLeave" bindmouseover="onHoverEnter" bindmouseout="onHoverLeave" bindtap="selectBid">{{item.bid}}</view>
            <view wx:else class="bid-disabled {{item.strainClass}}"><text class="bid-illegal-mark">✕</text>{{item.bid}}</view>
          </view>
        </block>
      </view>
      <view class="bid-footer">
        <view class="selected-bid-line">已选 {{selectedBid || '—'}}</view>
        <view class="action-row">
          <view class="action-btn primary-btn {{hoverKey === 'submit' ? 'is-hover' : ''}} {{submitted || !selectedBidLegal ? 'is-disabled' : ''}}" hover-class="primary-btn-hover" hover-start-time="0" hover-stay-time="100" data-hover="submit" bindmouseenter="onHoverEnter" bindmouseleave="onHoverLeave" bindmouseover="onHoverEnter" bindmouseout="onHoverLeave" bindtap="submitAnswer">提交</view>
          <view class="action-btn secondary-btn {{hoverKey === 'next' ? 'is-hover' : ''}}" hover-class="secondary-btn-hover" hover-start-time="0" hover-stay-time="100" data-hover="next" bindmouseenter="onHoverEnter" bindmouseleave="onHoverLeave" bindmouseover="onHoverEnter" bindmouseout="onHoverLeave" bindtap="loadQuestion">下一题</view>
          <view class="action-btn secondary-btn {{hoverKey === 'stats' ? 'is-hover' : ''}}" hover-class="secondary-btn-hover" hover-start-time="0" hover-stay-time="100" data-hover="stats" bindmouseenter="onHoverEnter" bindmouseleave="onHoverLeave" bindmouseover="onHoverEnter" bindmouseout="onHoverLeave" bindtap="showScoreStats">统计</view>
          <view class="action-btn secondary-btn {{hoverKey === 'clear' ? 'is-hover' : ''}}" hover-class="secondary-btn-hover" hover-start-time="0" hover-stay-time="100" data-hover="clear" bindmouseenter="onHoverEnter" bindmouseleave="onHoverLeave" bindmouseover="onHoverEnter" bindmouseout="onHoverLeave" bindtap="clearScoreStats">清空</view>
        </view>
      </view>
    </view>

    <view wx:if="{{submitted}}" class="card feedback {{answer.correct ? 'ok' : 'bad'}}">
      <view class="feedback-head">
        <view class="section-title">{{feedbackTitle}}</view>
        <view class="recommended-bid-row">推荐 <view class="recommended-bid {{recommendedBidClass}}">{{answer.recommended_bid}}</view></view>
      </view>
      <view class="subtitle feedback-explanation">{{answer.explanation}}</view>
      <view class="rule-name">{{answer.rule_name}}</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="card error-card">
    <view>{{error}}</view>
    <view class="secondary-btn {{hoverKey === 'retry' ? 'is-hover' : ''}}" hover-class="secondary-btn-hover" hover-start-time="0" hover-stay-time="100" data-hover="retry" bindmouseenter="onHoverEnter" bindmouseleave="onHoverLeave" bindmouseover="onHoverEnter" bindmouseout="onHoverLeave" bindtap="loadQuestion">重试</view>
  </view>
</view>
