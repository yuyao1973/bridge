.settings-page {
  padding: 16rpx;
}

.settings-page .card {
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 81, 50, 0.06);
}

.top-card {
  background: linear-gradient(135deg, #0f5132, #198754);
  color: #ffffff;
  padding: 14rpx 18rpx;
}

.page-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.settings-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.field-label {
  margin-bottom: 0;
  flex: 0 0 220rpx;
  color: #0f5132;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.3;
}

.field-picker {
  flex: 1;
  min-width: 0;
}

.picker-box {
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: right;
}

.hint-line {
  margin-top: 2rpx;
  color: #98a2b3;
  font-size: 20rpx;
  line-height: 1.3;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #eef0f2;
}

.switch-row-last {
  border-bottom: 0;
  padding-bottom: 0;
}

.switch-label {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.35;
  color: #101828;
}

.action-card {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.action-row {
  display: flex;
  align-items: stretch;
  gap: 10rpx;
}

.action-row .action-btn {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  padding: 14rpx 8rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.2;
}
