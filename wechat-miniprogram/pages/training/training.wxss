.training-page {
  padding: 16rpx;
}

.training-page .card {
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 81, 50, 0.06);
}

.top-card {
  background: linear-gradient(135deg, #0f5132, #198754);
  color: #ffffff;
  padding: 14rpx 18rpx;
}

.top-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.mode-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}

.stats-line {
  margin-top: 0;
  font-size: 22rpx;
  line-height: 1.3;
  color: #ecfdf3;
  font-weight: 600;
  text-align: right;
}

.field-label,
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f5132;
  margin-bottom: 8rpx;
}

.filter-card {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx 12rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.filter-row .field-label {
  margin-bottom: 0;
  flex-shrink: 0;
  min-width: 0;
  font-size: 22rpx;
  white-space: nowrap;
}

.filter-picker {
  flex: 1;
  min-width: 0;
}

.picker-box {
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  font-size: 22rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-card {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.context-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
}

.meta-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #101828;
}

.info-label {
  color: #667085;
  flex-shrink: 0;
}

.auction {
  margin-top: 0;
  padding: 10rpx 12rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
}

.auction-text {
  display: inline;
  color: #475467;
  font-size: 22rpx;
}

.auction-prompt {
  font-weight: 700;
  color: #0f5132;
}

.auction-bid {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  font-weight: 700;
  font-size: 22rpx;
  cursor: pointer;
}

.auction-bid:active {
  opacity: 0.8;
  transform: scale(0.95);
}

.auction-bid.bid-club {
  background: #ecfdf3;
  color: #067647;
}

.auction-bid.bid-diamond {
  background: #fff4e5;
  color: #b54708;
}

.auction-bid.bid-heart {
  background: #fff1f3;
  color: #c01048;
}

.auction-bid.bid-spade {
  background: #f2f4f7;
  color: #101828;
}

.auction-bid.bid-nt {
  background: #f4f3ff;
  color: #5925dc;
}

.auction-bid.bid-pass {
  background: #f2f4f7;
  color: #475467;
}

.auction-separator {
  color: #98a2b3;
  font-size: 20rpx;
}

.hand-card {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.hand-panel {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.hand-lines {
  flex: 1;
  min-width: 0;
}

.hand-line {
  font-size: 30rpx;
  font-weight: 600;
  padding: 2rpx 0;
  line-height: 1.25;
}

.metrics {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex: 0 0 120rpx;
  gap: 6rpx;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 4rpx 4rpx;
  border-radius: 10rpx;
  background: #f2f4f7;
  text-align: center;
}

.metric-value {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f5132;
  line-height: 1.15;
  word-break: break-all;
}

.metric-label {
  margin-top: 2rpx;
  color: #667085;
  font-size: 18rpx;
  line-height: 1.15;
}

.bid-footer {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
}

.selected-bid-line {
  margin-top: 0;
  margin-bottom: 0;
  flex: 0 0 auto;
  min-width: 88rpx;
  font-size: 22rpx;
  color: #667085;
  white-space: nowrap;
}

.action-row {
  display: flex;
  align-items: stretch;
  gap: 6rpx;
  margin-top: 0;
  flex: 1;
  min-width: 0;
}

.action-row .action-btn {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  padding: 10rpx 2rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.bid-grid {
  display: grid;
  gap: 6rpx;
  width: 100%;
  margin-top: 0;
  box-sizing: border-box;
}

.bid-card {
  padding: 14rpx 16rpx;
  overflow: visible;
}

.bid-cell {
  box-sizing: border-box;
  min-width: 0;
  width: auto;
}

.bid-grid.cols-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.bid-grid.cols-5 {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.bid-grid.cols-6 {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.bid-grid.cols-7 {
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.bid-btn,
.bid-disabled {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 44rpx;
  padding: 0 2rpx;
  margin: 0;
  border-radius: 8rpx;
  text-align: center;
  font-weight: 700;
  font-size: 20rpx;
  line-height: 1.15;
  white-space: nowrap;
  overflow: visible;
}

.bid-grid.cols-6 .bid-btn,
.bid-grid.cols-6 .bid-disabled,
.bid-grid.cols-7 .bid-btn,
.bid-grid.cols-7 .bid-disabled {
  font-size: 18rpx;
  min-height: 40rpx;
}

.bid-btn::after {
  border: 0;
}

.bid-btn {
  transition: filter 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
}

.bid-btn:hover,
.bid-btn.is-hover,
.bid-btn-hover {
  filter: brightness(0.92);
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.16);
  transform: translateY(-2rpx);
}

.bid-btn.selected:hover,
.bid-btn.selected.is-hover,
.bid-btn.selected.bid-btn-hover {
  filter: brightness(1.1);
  box-shadow: 0 10rpx 18rpx rgba(15, 81, 50, 0.32);
}

.bid-btn.locked:hover,
.bid-btn.locked.is-hover,
.bid-btn.locked.bid-btn-hover {
  filter: none;
  box-shadow: none;
  transform: none;
}

.bid-btn.selected {
  background: #0f5132;
  color: #ffffff;
}

.bid-btn.locked {
  opacity: 0.55;
}

.bid-disabled {
  opacity: 0.7;
}

.bid-illegal-mark {
  margin-right: 2rpx;
  color: #b42318;
  font-size: 0.9em;
}

.bid-club {
  background: #ecfdf3;
  color: #067647;
}

.bid-diamond {
  background: #fff4e5;
  color: #b54708;
}

.bid-heart {
  background: #fff1f3;
  color: #c01048;
}

.bid-spade {
  background: #f2f4f7;
  color: #101828;
}

.bid-nt {
  background: #f4f3ff;
  color: #5925dc;
}

.bid-pass {
  background: #f2f4f7;
  color: #475467;
}

.bid-disabled.bid-club,
.bid-disabled.bid-diamond,
.bid-disabled.bid-heart,
.bid-disabled.bid-spade,
.bid-disabled.bid-nt,
.bid-disabled.bid-pass {
  background: #f2f4f7;
  color: #98a2b3;
}

.feedback.ok {
  border-left: 8rpx solid #198754;
}

.feedback-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.feedback-head .section-title {
  margin-bottom: 0;
  font-size: 26rpx;
}

.feedback-explanation {
  white-space: pre-wrap;
  word-break: break-word;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.feedback.bad,
.error-card {
  border-left: 8rpx solid #dc3545;
}

.rule-name {
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
}

.recommended-bid-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 0;
  font-size: 22rpx;
  color: #667085;
  flex-shrink: 0;
}

.recommended-bid {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 700;
  font-size: 22rpx;
}

.recommended-bid.bid-club {
  background: #ecfdf3;
  color: #067647;
}

.recommended-bid.bid-diamond {
  background: #fff4e5;
  color: #b54708;
}

.recommended-bid.bid-heart {
  background: #fff1f3;
  color: #c01048;
}

.recommended-bid.bid-spade {
  background: #f2f4f7;
  color: #101828;
}

.recommended-bid.bid-nt {
  background: #f4f3ff;
  color: #5925dc;
}

.recommended-bid.bid-pass {
  background: #f2f4f7;
  color: #475467;
}
